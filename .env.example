# ============================================================================
# Sewa Entry — copy to .env and fill in. Never commit the real .env.
# ============================================================================

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to run against the in-memory PostgreSQL emulation
# (development only — every restart wipes the data and reloads the demo seed).
DATABASE_URL=postgres://sewa:sewa_dev_password@localhost:5432/sewa_entry

# Used by docker-compose to create the database container.
POSTGRES_USER=sewa
POSTGRES_PASSWORD=sewa_dev_password
POSTGRES_DB=sewa_entry
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
NODE_ENV=development
PORT=4001
API_PORT=4001

# REQUIRED in production; the server refuses to start with the dev default.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
KIOSK_TOKEN_EXPIRES_IN=30d

# Comma-separated. Only needed when the console is served from another origin
# (e.g. the Vite dev server); a single-origin deployment can leave it alone.
CORS_ORIGINS=http://localhost:5173

# --- Sewa schedule ----------------------------------------------------------
# Which days sewa runs. Sunday=0, Monday=1 … Saturday=6.
# The default, 0,3, is Sunday and Wednesday.
SEWA_DAYS=0,3

# How far a Sewadar may move their own in/out time from the moment they
# actually tapped. Generous on purpose — people forget to tap, and this is a
# volunteer roster, not a factory clock. An admin correcting the register is
# not bound by it.
TIME_ADJUST_TOLERANCE_MINUTES=120

# Allow attendance on a day that is not on the schedule. When true (the
# default) an extra sewa day is recorded and flagged rather than refused.
ALLOW_NON_SEWA_DAYS=true

# How far back a Sewadar may fill in a day they missed entirely. Older than
# this and only an admin can add it.
BACKFILL_DAYS=14

# --- Security ---------------------------------------------------------------
BCRYPT_ROUNDS=10
MAX_PIN_ATTEMPTS=3
PIN_LOCKOUT_MINUTES=5
MIN_PASSWORD_LENGTH=8
LOGIN_RATE_LIMIT=20
PUNCH_RATE_LIMIT=20
KIOSK_RATE_LIMIT=60

# --- Reporting --------------------------------------------------------------
# Times are stored as instants; reports render them in this zone.
REPORT_TIMEZONE=Asia/Kolkata
# A sewa longer than this is flagged as a probable forgotten sign-out.
MAX_SEWA_HOURS=14

# --- Seed data (local / demo use only) --------------------------------------
# The password given to the demo administrator (ADM001 / admin@sewa.local)
# created by `npm run seed`. Never run that script against a real production
# database — it fills it with a fake demo roster.
SEED_ADMIN_PASSWORD=sewa@admin1

# --- First-boot bootstrap (real deployments) ---------------------------------
# The ONE administrator created automatically the first time the app boots
# against a real, empty database — this is what gives a fresh production
# deployment a way to sign in at all, without seeding fake demo data into it.
# Does nothing once the database has anyone in it. Change this password from
# the console immediately after the first sign-in.
BOOTSTRAP_ADMIN_ID=ADMIN1
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=sewa@admin1
