{
  "name": "sewa-entry",
  "version": "1.0.0",
  "private": true,
  "description": "Sewa Entry — Sewadar attendance for an NGO: phone sign-in, counter tablet, department-wise Excel reports",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "docker:up": "docker compose up -d --build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "lint": "^1.2.2"
  }
}
